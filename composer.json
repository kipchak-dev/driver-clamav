{
    "name": "kipchak/driver-clamav",
    "type": "middleware",
    "description": "A ClamAV (clamd) antivirus driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "ClamAV",
        "clamd",
        "Antivirus",
        "Malware",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\ClamAV\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kipchak\\Driver\\ClamAV\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "kipchak/core": "^2 || ^3",
        "kipchak/driver-config": "^1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "extra": {
        "kipchak": {
            "type": "driver",
            "config": "sample.config.php",
            "configName": "kipchak.clamav.php",
            "initialise": "\\Kipchak\\Driver\\ClamAV\\ClamAV::initialise($container);",
            "after": [
                "kipchak/driver-config",
                "kipchak/driver-logger"
            ],
            "before": [],
            "docs": "https://kipchak.dev/docs/driver-clamav"
        }
    }
}
